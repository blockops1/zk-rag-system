# ZK-RAG System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Ethereum / Blockchain ───────────────────────────────────────────────────

# Private key for deploying and interacting with the MerkleRootRegistry contract
DEPLOYER_KEY=

# Ethereum RPC endpoint
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
TESTNET_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Deployed contract address
CONTRACT_ADDRESS=
TESTNET_CONTRACT_ADDRESS=
MAINNET_CONTRACT_ADDRESS=

# Active network: testnet | mainnet
ACTIVE_NETWORK=testnet

# ─── ZK Proofs ───────────────────────────────────────────────────────────────

# Number of parallel proof generation workers
ZK_PROOF_PARALLELISM=4

# Paths (relative to repo root or absolute)
ZK_MERKLE_TREES_DIR=./data/merkleTrees
ZK_CHUNKS_DIR=./data/chunks
ZK_PROOFS_DIR=./data/zk_proofs
ZK_PROOFS_TMP_DIR=./data/zk_proofs/tmp
ZK_LOG_DIR=./data/logs

# Registry
ZK_REGISTRY_PATH=./data/registry.json

# ─── Vector Database ────────────────────────────────────────────────────────

QDRANT_URL=http://127.0.0.1:6333

# ─── API Server ─────────────────────────────────────────────────────────────

# Admin API key for protected endpoints
ADMIN_API_KEY=

# ─── Harvester (Pipeline A) ──────────────────────────────────────────────────

# Base directory for harvested documents
BASE_DIR=./data

# Chunk and embedding output directories
CHUNKS_DIR=./data/chunks
EMBEDDINGS_DIR=./data/embeddings

# Logging
LOG_DIR=./data/logs

# Lock file for batch ingestion
LOCK_FILE=./data/ingest.lock
CHECKPOINT_FILE=./data/ingest_checkpoint.json

# Embedding model
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
